{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "meta": {
          "lastPackCreatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "lastFolderCreatedAt": { ".validate": "newData.isNumber() && newData.val() === now" }
        },

        "packs": {
          "$packId": {
            ".validate": "newData.hasChildren(['name']) && (data.exists() || !root.child('users').child($uid).child('meta').child('lastPackCreatedAt').exists() || now > root.child('users').child($uid).child('meta').child('lastPackCreatedAt').val() + 3000)",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "description": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 3000)" },
            "icon": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)" },
            "color": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
            "level": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)" },
            "folderId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
            "marketPackId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" }
          }
        },

        "folders": {
          "$folderId": {
            ".validate": "newData.hasChildren(['name']) && (data.exists() || !root.child('users').child($uid).child('meta').child('lastFolderCreatedAt').exists() || now > root.child('users').child($uid).child('meta').child('lastFolderCreatedAt').val() + 3000)",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "icon": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)" }
          }
        },

        "words": {
          "$packId": {
            "$wordId": {
              "word": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
              "translation": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
              "definition": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 3000)" },
              "example": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 3000)" },
              "notes": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)" },
              "partOfSpeech": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)" }
            }
          }
        },

        "profile": {
          "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
          "email": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 320)" },
          "photoURL": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)" }
        },

        "activity": {
          "lastSeen": { ".validate": "!newData.exists() || newData.isString()" },
          "sessionCount": { ".validate": "!newData.exists() || newData.isNumber()" }
        },

        "grammar": {
          "complex_attempts": {
            "$attemptId": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'azimjonxolmirzayev30@gmail.com')",
              "answers": {
                "$answerKey": {
                  ".validate": "newData.isString() && newData.val().length <= 5000"
                }
              }
            }
          }
        }
      }
    },
    "grammar_pending_attempts": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$attemptId": {
        ".write": "auth != null && (auth.token.email === 'azimjonxolmirzayev30@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid))",
        "answers": {
          "$answerKey": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          }
        },
        "studentEmail": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 320)" },
        "studentName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "testTitle": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" }
      }
    },
    "error_logs": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$logId": {
        ".write": "auth != null && (auth.token.email === 'azimjonxolmirzayev30@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid))",
        "message": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "stack": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)" },
        "url": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)" },
        "userAgent": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "context": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" }
      }
    },
    "globalWordStats": {
      ".read": "auth != null",
      "$wordKey": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['totalReviews', 'totalCorrect']) && newData.child('totalReviews').isNumber() && newData.child('totalCorrect').isNumber() && newData.child('totalCorrect').val() <= newData.child('totalReviews').val() && (!data.exists() || newData.child('totalReviews').val() >= data.child('totalReviews').val())"
      }
    }
  }
}
