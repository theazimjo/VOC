{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "grammar": {
          "complex_attempts": {
            "$attemptId": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'azimjonxolmirzayev30@gmail.com')"
            }
          }
        }
      }
    },
    "grammar_pending_attempts": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$attemptId": {
        ".write": "auth != null && (auth.token.email === 'azimjonxolmirzayev30@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid))"
      }
    },
    "error_logs": {
      ".read": "auth != null && auth.token.email === 'azimjonxolmirzayev30@gmail.com'",
      "$logId": {
        ".write": "auth != null && (auth.token.email === 'azimjonxolmirzayev30@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid))"
      }
    },
    "globalWordStats": {
      ".read": "auth != null",
      "$wordKey": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['totalReviews', 'totalCorrect']) && newData.child('totalReviews').isNumber() && newData.child('totalCorrect').isNumber() && newData.child('totalCorrect').val() <= newData.child('totalReviews').val() && (!data.exists() || newData.child('totalReviews').val() >= data.child('totalReviews').val())"
      }
    }
  }
}

